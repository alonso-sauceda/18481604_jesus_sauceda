	    id_evento SERIAL PRIMARY KEY,
	    momento TIMESTAMPTZ DEFAULT now(),
	    usuario_sesion TEXT DEFAULT session_user,
	    aplicacion TEXT DEFAULT current_setting('application_name'),
	    operacion TEXT NOT NULL,
	    id_cliente BIGINT,
	    valores_antes JSONB,
	    valores_despues JSONB
	);
2026-11-22 18:59:37.227 CST [4340] user=postgres db=comercial app=psql LOG:  sentencia: CREATE OR REPLACE FUNCTION auditoria.fn_auditar_clientes()
	RETURNS TRIGGER AS $$
	BEGIN
	    IF TG_OP = 'INSERT' THEN
	        INSERT INTO auditoria.cambios_clientes(operacion, id_cliente, valores_despues)
	        VALUES ('INSERT', NEW.id, to_jsonb(NEW));
	        RETURN NEW;
	    ELSIF TG_OP = 'UPDATE' THEN
	        INSERT INTO auditoria.cambios_clientes(operacion, id_cliente, valores_antes, valores_despues)
	        VALUES ('UPDATE', NEW.id, to_jsonb(OLD), to_jsonb(NEW));
	        RETURN NEW;
	    ELSIF TG_OP = 'DELETE' THEN
	        INSERT INTO auditoria.cambios_clientes(operacion, id_cliente, valores_antes)
	        VALUES ('DELETE', OLD.id, to_jsonb(OLD));
	        RETURN OLD;
	    END IF;
	    RETURN NULL;
	END;
	$$ LANGUAGE plpgsql SECURITY DEFINER;
